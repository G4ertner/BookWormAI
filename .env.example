# Server only. Copy this file to .env and insert your own OpenRouter key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional Fish voice ID. Blank uses provider default; no invented preset names.
FISH_AUDIO_VOICE_ID=
PORT=4310
# Local workstation demo only. Do not expose this unauthenticated server publicly.
HOST=127.0.0.1
